{
  "name": "@hyzer-labs/annotate",
  "version": "0.2.1",
  "description": "Annotate any page in the browser and send the element, screenshot, and your comment to your local coding agent over MCP.",
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "hyzer-annotate": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "esbuild src/server.ts --outfile=dist/server.js --platform=node --format=esm --packages=external --banner:js=\"#!/usr/bin/env node\"",
    "build:extension": "node scripts/build-extension.mjs",
    "build:all": "npm run build && npm run build:extension",
    "icons": "node scripts/generate-icons.mjs",
    "package:extension": "node scripts/build-extension-zip.mjs",
    "prepublishOnly": "npm run check",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/geometry.mjs && node test/token-scope.mjs && node test/smoke.mjs && node test/persistence.mjs",
    "check": "npm run typecheck && npm run test && npm run build:extension"
  },
  "keywords": [
    "mcp",
    "browser",
    "annotation",
    "chrome",
    "coding-agent",
    "localhost"
  ],
  "license": "GPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyzerlabs/annotate.git"
  },
  "homepage": "https://github.com/hyzerlabs/annotate#readme",
  "bugs": {
    "url": "https://github.com/hyzerlabs/annotate/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@hyzer-labs/ui": "^0.7.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
